{
  "name": "xupply-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Xupply - Plataforma B2B para Restaurantes y Proveedores",
  "workspaces": [
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "web": "npm run dev --prefix app/frontend",
    "server": "npm run dev --prefix app/backend",
    "check:structure": "node scripts/check-structure.mjs",
    "check:structure:update": "node scripts/check-structure.mjs --update"
  }
}
