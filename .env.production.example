DOMAIN=xupply.example.com
POSTGRES_DB=xupply
POSTGRES_USER=xupply
POSTGRES_PASSWORD=change-this-password
JWT_SECRET=change-this-long-random-secret
CLIENT_ORIGIN=https://xupply.example.com
DATABASE_URL=postgres://xupply:change-this-password@db:5432/xupply
PORT=4420

# Agente XupAI (Compra Inteligente con DeepSeek u OpenAI):
# Opción 1: DeepSeek (Recomendado)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
XUPAI_MODEL=deepseek-chat
XUPAI_BASE_URL=https://api.deepseek.com

# Opción 2: Variable genérica XUPAI
# XUPAI_API_KEY=sk-your-deepseek-or-openai-key

