DOMAIN=xupply.example.com
POSTGRES_DB=xupply
POSTGRES_USER=xupply
POSTGRES_PASSWORD=change-this-password
JWT_SECRET=change-this-long-random-secret
CLIENT_ORIGIN=https://xupply.example.com
DATABASE_URL=postgres://xupply:change-this-password@db:5432/xupply
PORT=4420

# Agente XupAI (Compra Inteligente). Obligatorio para habilitar el agente LLM.
XUPAI_API_KEY=sk-your-openai-compatible-key
