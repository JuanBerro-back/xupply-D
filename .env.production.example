# ============================================================
# Xupply - variables de entorno para PRODUCCIÓN
# Copia este archivo a .env.production (nunca lo subas al repo).
# Genera secretos con:  openssl rand -base64 48
# ============================================================

NODE_ENV=production
DOMAIN=xupply.example.com
PORT=4420

# --- PostgreSQL ---
POSTGRES_DB=xupply
POSTGRES_USER=xupply
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_LARGA
DATABASE_URL=postgres://xupply:CAMBIA_ESTA_CONTRASENA_LARGA@db:5432/xupply

# --- Autenticación ---
# Obligatorio. El servidor se niega a arrancar en producción sin este valor.
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_64_CARACTERES
JWT_EXPIRES_IN=12h

# Origen(es) permitidos para CORS, separados por coma. Sin esto, en producción
# no se acepta ningún origen cruzado (fail-closed).
CLIENT_ORIGIN=https://xupply.example.com

# --- Bootstrap del administrador ---
# Solo se usa la primera vez, cuando la base de datos no tiene usuarios.
# La contraseña debe tener 12+ caracteres. Elimina estas variables después.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_DE_ADMIN

# NUNCA activar en producción: crea usuarios demo con contraseñas conocidas.
SEED_DEMO_DATA=false

# --- Agente XupAI (opcional) ---
# Opción 1: DeepSeek (recomendado)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
XUPAI_MODEL=deepseek-chat
XUPAI_BASE_URL=https://api.deepseek.com

# Opción 2: variable genérica
# XUPAI_API_KEY=sk-your-deepseek-or-openai-key

# --- Correo transaccional enterprise ---
# Rellena estos valores con datos reales: los placeholders no envían correo.
# smtp | resend | emailjs  (vacío = autodetección)
MAIL_PROVIDER=smtp
# Usa SIEMPRE un dominio corporativo verificado. Nunca gmail.com/hotmail.com en producción.
MAIL_FROM=notificaciones@tudominio.com
MAIL_FROM_NAME=Xupply
# Bandeja de entrada enterprise que recibe las respuestas de los clientes.
MAIL_REPLY_TO=soporte@tudominio.com
# Copia oculta de auditoría (opcional, recomendado en enterprise).
MAIL_BCC=auditoria@tudominio.com
# Selectores DKIM para verificar el DNS desde /api/admin/email/dns.
# Si no se define, se prueban los selectores habituales del proveedor.
MAIL_DKIM_SELECTORS=google
APP_URL=https://tudominio.com
MAIL_COMPANY_NAME=Xupply
MAIL_COMPANY_ADDRESS=Bucaramanga, Santander, Colombia

# SMTP empresarial (Google Workspace, Microsoft 365, Amazon SES, Zoho...)
# Google Workspace: smtp.gmail.com:587 con contraseña de aplicación.
# Microsoft 365: smtp.office365.com:587 (requiere SMTP AUTH habilitado).
# Amazon SES: email-smtp.<region>.amazonaws.com:587 con credenciales SMTP.
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=CAMBIA_ESTA_CONTRASENA

# Alternativa recomendada: Resend (DKIM/SPF gestionados)
# RESEND_API_KEY=re_xxxxxxxxx

# EmailJS (legacy, solo si no usas SMTP/Resend)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
