# ============================================================
# Xupply - variables de entorno para DESARROLLO LOCAL
# Copia este archivo a app/server/.env (está en .gitignore).
# ============================================================

NODE_ENV=development
PORT=4420

# PostgreSQL local
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/xupply

# Secreto de desarrollo. En producción usa uno aleatorio de 64+ caracteres.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=12h

# Orígenes permitidos (CORS). En desarrollo se aceptan orígenes cruzados
# aunque esta lista esté vacía; en producción NO.
CLIENT_ORIGIN=http://localhost:5173

# Datos de demostración (usuarios demo con contraseña conocida).
# true solo en local. En producción debe ser false.
SEED_DEMO_DATA=true

# Administrador inicial (opcional, solo si no hay usuarios)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=una-contrasena-de-12-o-mas-caracteres

# XupAI (opcional)
# DEEPSEEK_API_KEY=sk-...
# XUPAI_MODEL=deepseek-chat
# XUPAI_BASE_URL=https://api.deepseek.com

# --- Correo transaccional (opcional en local) ---
# En local puedes dejar todo vacío: los correos se omiten sin romper la app.
# Para probar el envío real usa SMTP o Resend (ver EMAIL-ENTERPRISE.md).
MAIL_PROVIDER=
MAIL_FROM=
MAIL_FROM_NAME=Xupply
MAIL_REPLY_TO=
MAIL_BCC=
APP_URL=http://localhost:5173
MAIL_COMPANY_NAME=Xupply
MAIL_COMPANY_ADDRESS=Bucaramanga, Santander, Colombia
# MAIL_DKIM_SELECTORS=google

# SMTP (Google Workspace / Microsoft 365 / Amazon SES / Zoho)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@tudominio.com
# SMTP_PASS=tu-contrasena-de-aplicacion

# Resend
# RESEND_API_KEY=re_...

# EmailJS (legacy)
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
