PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xupply
# Obligatorio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# --- Correo transaccional ---
# En local puedes dejarlo vacío: los correos se omiten sin romper la app.
MAIL_PROVIDER=
MAIL_FROM=
MAIL_FROM_NAME=Xupply
MAIL_REPLY_TO=
MAIL_BCC=
APP_URL=http://localhost:5173
MAIL_COMPANY_NAME=Xupply
MAIL_COMPANY_ADDRESS=Bucaramanga, Santander, Colombia
# MAIL_DKIM_SELECTORS=google

# SMTP empresarial
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@tudominio.com
# SMTP_PASS=tu-contrasena-de-aplicacion

# Resend (alternativa)
# RESEND_API_KEY=re_...

# EmailJS (legacy)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Agente XupAI (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
XUPAI_MODEL=deepseek-chat
XUPAI_BASE_URL=https://api.deepseek.com
