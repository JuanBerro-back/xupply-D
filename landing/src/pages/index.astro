---
import '../styles/global.css';
import { site as s, extra as x } from '../config';

const chips = [...x.chips, ...x.chips];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0284c7" />
    <meta name="description" content={s.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{s.name} • {s.tagline}</title>
  </head>
  <body>
    <!-- Top Scroll Progress Line -->
    <div id="pg"></div>

    <!-- Ambient Subtle Blurs in Original Brand Sky & Emerald Colors -->
    <div class="aur" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </div>

    <!-- Interactive Canvas Particle Network -->
    <canvas id="fx" aria-hidden="true"></canvas>

    <!-- Top Navigation -->
    <nav>
      <div class="wrap">
        <div class="nav-brand">
          <div class="logo-badge">X</div>
          <a class="logo" href="#">
            {s.name.slice(0, -4)}<b>{s.name.slice(-4)}</b>
          </a>
        </div>

        <div class="nav-links">
          <a href="#features">Características</a>
          <a href="#simulador">Simulador</a>
          <a href="#roles">Roles</a>
          <a href="#como">Cómo Funciona</a>
          <a href="#comparativa">Beneficios</a>
        </div>

        <div class="nav-actions">
          <a class="btn ghost sm" href={s.loginUrl} rel="noreferrer">Iniciar Sesión</a>
          <a class="btn sm" href={s.registerUrl} rel="noreferrer">Registrarse</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <header class="wrap hero">
      <div>

        <h1>
          {s.hero.title}
          <br />
          <span class="gt" id="tw"></span>
          <span class="caret"></span>
        </h1>

        <p>{s.hero.sub}</p>

        <div class="hero-actions">
          <a class="btn" href={s.appUrl} target="_blank" rel="noreferrer">
            <span>{s.hero.cta}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a class="btn ghost" href="#simulador">
            <span>{s.hero.cta2}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </a>
        </div>

        <p class="hero-subtext">Más de 50 restaurantes y distribuidores operando en Bucaramanga y Santander</p>
      </div>

      <!-- Hero Visual: Clean Live Telemetry HUD (Without Floating Toasts/Modals) -->
      <div class="vis">
        <div class="glass tilt map-card">
          <div class="map-header">
            <div class="map-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Telemetría GPS en Vivo</span>
            </div>
            <div class="telemetry-row">
              <span>Vel: <b id="tele-speed">42 km/h</b></span>
              <span>ETA: <b id="tele-eta">14 min</b></span>
            </div>
          </div>

          <!-- SVG Simulated Delivery Map with Authentic Brand Colors -->
          <div class="map-wrap">
            <svg class="map-svg" viewBox="0 0 420 260" role="img" aria-label="Mapa interactivo con ruta de entrega en Bucaramanga">
              <defs>
                <linearGradient id="routeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0284c7" />
                  <stop offset="60%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#10b981" />
                </linearGradient>
                <filter id="routeGlow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="4" result="glow" />
                  <feComposite in="SourceGraphic" in2="glow" operator="over" />
                </filter>
              </defs>

              <!-- Grid map roads -->
              <g stroke="#1e293b" stroke-width="1.2">
                {[1, 2, 3, 4, 5, 6, 7].map((i) => (
                  <line x1={i * 55} y1="0" x2={i * 55} y2="260" stroke-dasharray="3 3" />
                ))}
                {[1, 2, 3, 4, 5].map((i) => (
                  <line x1="0" y1={i * 50} x2="420" y2={i * 50} stroke-dasharray="3 3" />
                ))}
              </g>

              <!-- Secondary roads -->
              <path d="M 20 60 Q 140 80 200 130 T 400 190" fill="none" stroke="#172554" stroke-width="2" />
              <path d="M 60 240 Q 180 200 240 140 T 360 40" fill="none" stroke="#172554" stroke-width="2" />

              <!-- Landmarks labels -->
              <text x="35" y="235" fill="#64748b" font-size="10" font-family="monospace">Bodega Central (Girón)</text>
              <text x="260" y="32" fill="#64748b" font-size="10" font-family="monospace">Restaurante (Cabecera)</text>
              <text x="180" y="115" fill="#38bdf8" font-size="9" opacity="0.6" font-family="monospace">Viaducto García Cadena</text>

              <!-- Delivery Path Glow & Main -->
              <path
                id="deliveryPath"
                d="M 50 210 L 80 155 L 160 155 L 195 100 L 290 100 L 320 50 L 370 50"
                fill="none"
                stroke="url(#routeGrad)"
                stroke-width="8"
                opacity="0.3"
                filter="url(#routeGlow)"
              />
              <path
                d="M 50 210 L 80 155 L 160 155 L 195 100 L 290 100 L 320 50 L 370 50"
                fill="none"
                stroke="url(#routeGrad)"
                stroke-width="3"
                stroke-dasharray="8 6"
                stroke-linecap="round"
              >
                <animate attributeName="stroke-dashoffset" from="28" to="0" dur="0.8s" repeatCount="indefinite" />
              </path>

              <!-- Origin beacon -->
              <circle cx="50" cy="210" r="8" fill="#0284c7" />
              <circle cx="50" cy="210" r="3" fill="#ffffff" />

              <!-- Destination beacon in Emerald -->
              <circle cx="370" cy="50" r="8" fill="#10b981">
                <animate attributeName="r" values="8;16;8" dur="2s" repeatCount="indefinite" />
                <animate attributeName="opacity" values="1;0.3;1" dur="2s" repeatCount="indefinite" />
              </circle>
              <circle cx="370" cy="50" r="4" fill="#ffffff" />

              <!-- Moving clean SVG vehicle marker (No emojis) -->
              <g>
                <animateMotion id="vanMotion" dur="8s" repeatCount="indefinite" rotate="auto">
                  <mpath href="#deliveryPath" />
                </animateMotion>
                <circle cx="0" cy="0" r="10" fill="#0284c7" stroke="#38bdf8" stroke-width="2" />
                <path d="M-3 -4 L4 0 L-3 4 Z" fill="#ffffff" />
              </g>
            </svg>
          </div>

          <!-- Interactive Status Stepper -->
          <div class="map-footer">
            <div class="sts" id="stepper">
              {s.statuses.map((item, index) => (
                <button
                  class={'st' + (index === 0 ? ' on' : '')}
                  data-step-idx={index}
                  title={item.desc}
                >
                  {item.label}
                </button>
              ))}
            </div>

            <!-- Progress Bar in Brand Sky Blue -->
            <div class="bar">
              <i id="bar"></i>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px;">
              <span id="step-desc" style="font-size: 0.8rem; color: var(--text-muted);">
                {s.statuses[0].desc}
              </span>
              <button id="btn-fast-forward" class="btn ghost sm" style="font-size: 0.76rem; padding: 3px 10px;">
                Simular Entrega
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Infinite Marquee Ticker -->
    <div class="mq" aria-hidden="true">
      <div>
        {chips.map((chip) => (
          <span>
            <b>•</b> {chip}
          </span>
        ))}
      </div>
    </div>

    <!-- Main Content -->
    <main class="wrap">
      <!-- KPI Stats Section -->
      <section class="rv">
        <div class="stats">
          {s.stats.map((stat, i) => (
            <div class="glass tilt stat-card rv" style={`--i:${i}`}>
              <b class="gt" data-n={stat.n} data-prefix={stat.prefix} data-suffix={stat.suffix}>
                0
              </b>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Features Section (Clean SVG Icons, No Emojis) -->
      <section id="features" class="rv">
        <div class="sec-head">
          <h2>Todo lo que tu cadena de suministros necesita</h2>
          <p class="sub">
            Diseñado especialmente para el sector gastronómico y distribuidor en Colombia. Del pedido al plato, sin hojas de cálculo.
          </p>
        </div>

        <div class="grid">
          {s.features.map((feature, i) => (
            <div class="glass tilt feat rv" style={`--i:${i}`}>
              <div class="feat-top">
                <div class="feat-icon-box">
                  {feature.icon === 'radar' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2a10 10 0 1 0 10 10"></path>
                      <path d="M12 6a6 6 0 1 0 6 6"></path>
                      <circle cx="12" cy="12" r="2"></circle>
                    </svg>
                  )}
                  {feature.icon === 'invoice' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                      <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                  )}
                  {feature.icon === 'box' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m7.5 4.27 9 5.15"></path>
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                      <path d="m3.3 7 8.7 5 8.7-5"></path>
                      <path d="M12 22V12"></path>
                    </svg>
                  )}
                  {feature.icon === 'ai' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2v4"></path>
                      <path d="M12 18v4"></path>
                      <path d="M4.93 4.93l2.83 2.83"></path>
                      <path d="M16.24 16.24l2.83 2.83"></path>
                      <path d="M2 12h4"></path>
                      <path d="M18 12h4"></path>
                      <path d="M4.93 19.07l2.83-2.83"></path>
                      <path d="M16.24 7.76l2.83-2.83"></path>
                    </svg>
                  )}
                  {feature.icon === 'shield' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  )}
                  {feature.icon === 'location' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                    </svg>
                  )}
                </div>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- LIVE INTERACTIVE SIMULATOR (No Emojis, Clean Spacing) -->
      <section id="simulador" class="rv">
        <div class="sec-head">
          <h2>Simula un Pedido con Descuento FEFO y Facturación DIAN</h2>
          <p class="sub">
            Calcula en tiempo real el ahorro por rotación FEFO y comprueba la emisión de la factura electrónica.
          </p>
        </div>

        <div class="simulator-box">
          <!-- Left: Order Builder Controls -->
          <div class="sim-controls">
            <h4>1. Tipo de establecimiento:</h4>
            <div class="type-buttons" id="type-selector">
              <button class="type-btn active" data-type="burger">Hamburguesería</button>
              <button class="type-btn" data-type="pizza">Pizzería</button>
              <button class="type-btn" data-type="cafe">Café y Panadería</button>
              <button class="type-btn" data-type="grill">Parrilla y Carnes</button>
            </div>

            <h4>2. Configurar insumos requeridos:</h4>
            <div class="sim-items" id="sim-product-list">
              {s.simulatorProducts.map((prod) => (
                <div class="sim-item" data-id={prod.id} data-price={prod.price} data-fefo={prod.fefoDiscount}>
                  <div class="sim-item-info">
                    <span class="sim-item-name">{prod.name}</span>
                    <span class="sim-item-meta">
                      ${prod.price.toLocaleString('es-CO')} COP / {prod.unit} •
                      <span class="sim-item-fefo">
                        Lote FEFO (-{Math.round(prod.fefoDiscount * 100)}%)
                      </span>
                    </span>
                  </div>
                  <div class="sim-qty-control">
                    <button class="qty-btn dec" data-id={prod.id} aria-label="Disminuir">-</button>
                    <span class="qty-val" id={`qty-${prod.id}`}>1</span>
                    <button class="qty-btn inc" data-id={prod.id} aria-label="Aumentar">+</button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Right: Simulated DIAN Electronic Receipt -->
          <div class="sim-receipt">
            <div class="receipt-header">
              <div class="receipt-title">
                <span>Factura Electrónica de Venta</span>
              </div>
              <div class="receipt-meta">
                <div>Emisor: Xupply Mayorista B2B (NIT 901.482.193-4)</div>
                <div>Adquirente: Restaurante Asociado Bucaramanga</div>
                <div>Fecha: <span id="receipt-date">Hoy</span> • Régimen Común</div>
              </div>
            </div>

            <div class="receipt-breakdown">
              <div class="receipt-row">
                <span>Subtotal Bruto</span>
                <span id="rc-subtotal">$0 COP</span>
              </div>
              <div class="receipt-row discount">
                <span>Ahorro Inteligente FEFO</span>
                <span id="rc-fefo">-$0 COP</span>
              </div>
              <div class="receipt-row">
                <span>Impoconsumo (8%) / IVA</span>
                <span id="rc-tax">$0 COP</span>
              </div>
              <div class="receipt-total">
                <span>Total a Pagar</span>
                <b id="rc-total">$0 COP</b>
              </div>
            </div>

            <div class="cufe-box">
              <b>CUFE (Código Único de Factura Electrónica):</b>
              <span id="rc-cufe">8f3b92c47a1098e21054de74b39a...01cb</span>
            </div>

            <button id="btn-place-demo-order" class="btn" style="width: 100%;">
              <span>Emitir Pedido y Factura Demo</span>
            </button>
          </div>
        </div>
      </section>

      <!-- Roles Section (Clean SVG Icons, No Emojis) -->
      <section id="roles" class="rv">
        <div class="sec-head">
          <h2>Una experiencia dedicada para cada rol</h2>
          <p class="sub">
            Consolas especializadas para cada usuario dentro de la cadena de suministro.
          </p>
        </div>

        <!-- Role Tabs -->
        <div class="role-tabs" id="roleTabs">
          {s.roles.map((role, i) => (
            <button
              class={'role-tab-btn' + (i === 0 ? ' active' : '')}
              data-role={role.key}
            >
              <span>{role.name}</span>
            </button>
          ))}
        </div>

        <!-- Role Panels -->
        <div class="glass" style="padding: 28px;">
          {s.roles.map((role, i) => (
            <div class={'role-panel' + (i === 0 ? ' active' : '')} data-panel={role.key}>
              <div class="role-info">
                <h3>{role.name}</h3>
                <p>{role.summary}</p>
                <ul class="role-highlights">
                  {role.highlights.map((item) => (
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                <a class="btn sm" href={s.appUrl} target="_blank" rel="noreferrer">
                  <span>Probar vista de {role.name}</span>
                </a>
              </div>

              <div class="mockup-preview">
                <div class="mockup-header">
                  <div class="mockup-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                  <div class="mockup-title">{role.mockupData.title}</div>
                </div>

                <div class="mockup-metrics">
                  {role.mockupData.metrics.map((m) => (
                    <div class="m-metric">
                      <span>{m.label}</span>
                      <b>{m.val}</b>
                    </div>
                  ))}
                </div>

                <div style="background: rgba(15,23,42,0.6); border: 1px solid var(--line); border-radius: 10px; padding: 14px; text-align: center;">
                  <span style="font-size: 0.8rem; color: var(--text-muted); display: block; margin-bottom: 8px;">
                    Acción principal en consola:
                  </span>
                  <button class="btn sm ghost" style="width: 100%;">
                    {role.mockupData.actionText}
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Steps Flow (Cómo Funciona) -->
      <section id="como" class="rv">
        <div class="sec-head">
          <h2>Cómo funciona Xupply</h2>
          <p class="sub">Cuatro etapas simples sincronizadas en una sola fuente de verdad.</p>
        </div>

        <div class="steps-grid">
          {s.steps.map((st, i) => (
            <div class="glass tilt step-card rv" style={`--i:${i}`}>
              <div class="step-num">{st.step}</div>
              <h3>{st.title}</h3>
              <p>{st.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Comparison Section -->
      <section id="comparativa" class="rv">
        <div class="sec-head">
          <h2>Comparativa Operativa</h2>
          <p class="sub">Compara la operación tradicional frente a la plataforma Xupply.</p>
        </div>

        <table class="compare-table">
          <thead>
            <tr>
              <th style="width: 30%;">Aspecto Operativo</th>
              <th style="width: 35%;">Método Tradicional</th>
              <th style="width: 35%;">Con Xupply B2B</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b>Pedidos y Compras</b></td>
              <td class="compare-bad">Llamadas telefónicas y chats de mensajería dispersos</td>
              <td class="compare-good">Catálogo digital con confirmación instantánea</td>
            </tr>
            <tr>
              <td><b>Control de Vencimiento</b></td>
              <td class="compare-bad">Alimentos vencen en bodega; mermas del 8% al 15%</td>
              <td class="compare-good">Algoritmo FEFO estricto: rotación prioritaria y 0% mermas</td>
            </tr>
            <tr>
              <td><b>Rastreo de Entregas</b></td>
              <td class="compare-bad">Llamadas frecuentes al conductor durante la ruta</td>
              <td class="compare-good">GPS satelital en vivo con telemetría y ETA en tiempo real</td>
            </tr>
            <tr>
              <td><b>Facturación e Impuestos</b></td>
              <td class="compare-bad">Facturas manuales en papel, errores en IVA e INC</td>
              <td class="compare-good">Facturación electrónica DIAN con CUFE y QR al instante</td>
            </tr>
            <tr>
              <td><b>Decisiones de Compra</b></td>
              <td class="compare-bad">Estimaciones sin datos históricos de rotación</td>
              <td class="compare-good">Copiloto XupAI analiza consumos históricos y sugiere la orden</td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Testimonials -->
      <section class="rv">
        <div class="sec-head">
          <h2>Respaldado por el sector gastronómico de Bucaramanga</h2>
        </div>

        <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));">
          {s.testimonials.map((t, i) => (
            <div class="glass tilt feat rv" style={`--i:${i}`}>
              <p style="font-style: italic; font-size: 0.98rem; margin-bottom: 16px; color: var(--text);">
                "{t.quote}"
              </p>
              <div>
                <b style="display: block; color: var(--text); font-size: 0.95rem;">{t.name}</b>
                <span style="font-size: 0.82rem; color: var(--brand-light);">{t.role}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA Section -->
      <section class="rv">
        <div class="cta-box">
          <h2>Lleva tu operación al <span class="gt">siguiente nivel</span></h2>
          <p>
            Comienza a operar hoy mismo. Conéctate con los mejores distribuidores y gestiona tu cocina con precisión digital.
          </p>

          <div class="cta-buttons">
            <a class="btn" href={s.registerUrl} rel="noreferrer">
              <span>Registrarse</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>

            <a class="btn ghost sm" href={s.apkUrl} download>
              <span>Descargar APK Android</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer>
      <div class="wrap footer-content">
        <div class="footer-left">
          <p>{s.footer.copy}</p>
          <span>{s.footer.location} • {s.footer.sub}</span>
        </div>

        <div class="footer-right">
          <a href="#features">Características</a>
          <a href="#simulador">Simulador</a>
          <a href="#roles">Roles</a>
          <a href={s.loginUrl} rel="noreferrer">Iniciar Sesión</a>
          <a href={s.registerUrl} rel="noreferrer">Registrarse</a>
        </div>
      </div>
    </footer>

    <!-- Client-Side Scripts (Typewriter, Stepper, Simulator, Canvas) -->
    <script define:vars={{ words: x.words, statuses: s.statuses, simulatorProductsByType: s.simulatorProductsByType }}>
      // 1. Typewriter Effect in Hero
      const tw = document.getElementById('tw');
      let wordIdx = 0, charIdx = 0, deleting = false;

      function typeLoop() {
        if (!tw) return;
        const currentWord = words[wordIdx];
        charIdx += deleting ? -1 : 1;
        tw.textContent = currentWord.slice(0, charIdx);
        let delay = deleting ? 35 : 75;

        if (!deleting && charIdx === currentWord.length) {
          deleting = true;
          delay = 1800;
        } else if (deleting && charIdx === 0) {
          deleting = false;
          wordIdx = (wordIdx + 1) % words.length;
          delay = 350;
        }
        setTimeout(typeLoop, delay);
      }
      typeLoop();

      // 2. Scroll Progress Bar
      const pg = document.getElementById('pg');
      window.addEventListener('scroll', () => {
        if (!pg) return;
        const total = document.body.scrollHeight - window.innerHeight;
        const current = window.scrollY;
        pg.style.width = total > 0 ? (current / total) * 100 + '%' : '0%';
      }, { passive: true });

      // 3. Scroll Reveal & Metric Counter
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in');
          observer.unobserve(entry.target);

          entry.target.querySelectorAll('[data-n]').forEach((el) => {
            const targetNum = +el.dataset.n;
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            let current = 0;
            const step = Math.max(1, Math.ceil(targetNum / 35));
            const timer = setInterval(() => {
              current += step;
              if (current >= targetNum) {
                current = targetNum;
                clearInterval(timer);
              }
              el.textContent = `${prefix}${current}${suffix}`;
            }, 30);
          });
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.rv').forEach((el) => observer.observe(el));

      // 4. Interactive Delivery Stepper & Simulation
      const stepBtns = [...document.querySelectorAll('#stepper .st')];
      const progressBar = document.getElementById('bar');
      const stepDesc = document.getElementById('step-desc');
      const teleSpeed = document.getElementById('tele-speed');
      const teleEta = document.getElementById('tele-eta');
      const btnFastForward = document.getElementById('btn-fast-forward');
      let currentStep = 0;

      function updateStep(idx) {
        currentStep = idx;
        stepBtns.forEach((btn, k) => btn.classList.toggle('on', k === idx));
        if (progressBar) {
          progressBar.style.width = ((idx + 1) / statuses.length) * 100 + '%';
        }
        if (stepDesc && statuses[idx]) {
          stepDesc.textContent = statuses[idx].desc;
        }
        if (teleSpeed && teleEta) {
          if (idx === 0) {
            teleSpeed.textContent = '0 km/h';
            teleEta.textContent = '28 min';
          } else if (idx === 1) {
            teleSpeed.textContent = '0 km/h (Bodega)';
            teleEta.textContent = '24 min';
          } else if (idx === 2) {
            teleSpeed.textContent = '15 km/h';
            teleEta.textContent = '19 min';
          } else if (idx === 3) {
            teleSpeed.textContent = '44 km/h';
            teleEta.textContent = '8 min';
          } else if (idx === 4) {
            teleSpeed.textContent = '0 km/h (Destino)';
            teleEta.textContent = 'Entregado';
          }
        }
      }

      let stepInterval = setInterval(() => {
        updateStep((currentStep + 1) % statuses.length);
      }, 3500);

      stepBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          clearInterval(stepInterval);
          const idx = +btn.dataset.stepIdx;
          updateStep(idx);
        });
      });

      if (btnFastForward) {
        btnFastForward.addEventListener('click', () => {
          clearInterval(stepInterval);
          updateStep(4);
          btnFastForward.textContent = 'Entrega Completada';
          setTimeout(() => {
            btnFastForward.textContent = 'Simular Entrega';
          }, 3000);
        });
      }

      // 5. 3D Tilt Card Effect
      document.querySelectorAll('.tilt').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;
          const py = (e.clientY - rect.top) / rect.height;
          card.style.setProperty('--ry', (px - 0.5) * 12 + 'deg');
          card.style.setProperty('--rx', (0.5 - py) * 12 + 'deg');
          card.style.setProperty('--mx', px * 100 + '%');
          card.style.setProperty('--my', py * 100 + '%');
        });
        card.addEventListener('mouseleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });

      // 6. Role Tabs Switcher
      const roleTabs = document.querySelectorAll('.role-tab-btn');
      const rolePanels = document.querySelectorAll('.role-panel');

      roleTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetKey = tab.dataset.role;
          roleTabs.forEach((t) => t.classList.toggle('active', t === tab));
          rolePanels.forEach((p) => p.classList.toggle('active', p.dataset.panel === targetKey));
        });
      });

      // 7. Interactive Simulator by Establishment Type
      const quantities = {};
      let currentProducts = simulatorProductsByType.burger || [];

      function initQuantitiesForType(type) {
        const prods = simulatorProductsByType[type] || simulatorProductsByType.burger || [];
        currentProducts = prods;
        prods.forEach((p) => {
          if (quantities[p.id] === undefined) {
            quantities[p.id] = p.defaultQty !== undefined ? p.defaultQty : 1;
          }
        });
      }

      initQuantitiesForType('burger');

      const rcSubtotal = document.getElementById('rc-subtotal');
      const rcFefo = document.getElementById('rc-fefo');
      const rcTax = document.getElementById('rc-tax');
      const rcTotal = document.getElementById('rc-total');
      const rcCufe = document.getElementById('rc-cufe');
      const btnPlaceDemoOrder = document.getElementById('btn-place-demo-order');
      const simProductList = document.getElementById('sim-product-list');

      function calculateSim() {
        let rawSubtotal = 0;
        let fefoSavings = 0;

        currentProducts.forEach((p) => {
          const qty = quantities[p.id] || 0;
          const itemTotal = p.price * qty;
          rawSubtotal += itemTotal;
          fefoSavings += itemTotal * p.fefoDiscount;
        });

        const subtotalAfterFefo = rawSubtotal - fefoSavings;
        const tax = Math.round(subtotalAfterFefo * 0.08); // 8% Impoconsumo
        const total = subtotalAfterFefo + tax;

        if (rcSubtotal) rcSubtotal.textContent = `$${Math.round(rawSubtotal).toLocaleString('es-CO')} COP`;
        if (rcFefo) rcFefo.textContent = `-$${Math.round(fefoSavings).toLocaleString('es-CO')} COP`;
        if (rcTax) rcTax.textContent = `$${tax.toLocaleString('es-CO')} COP`;
        if (rcTotal) rcTotal.textContent = `$${Math.round(total).toLocaleString('es-CO')} COP`;
      }

      function bindQtyButtons() {
        if (!simProductList) return;
        simProductList.querySelectorAll('.qty-btn').forEach((btn) => {
          btn.onclick = () => {
            const id = +btn.dataset.id;
            const isInc = btn.classList.contains('inc');
            if (isInc) {
              quantities[id] = (quantities[id] || 0) + 1;
            } else {
              quantities[id] = Math.max(0, (quantities[id] || 0) - 1);
            }
            const valEl = document.getElementById(`qty-${id}`);
            if (valEl) valEl.textContent = quantities[id];
            calculateSim();
          };
        });
      }

      function renderSimulatorItems(type) {
        initQuantitiesForType(type);
        if (!simProductList) return;
        simProductList.innerHTML = currentProducts.map((prod) => `
          <div class="sim-item" data-id="${prod.id}" data-price="${prod.price}" data-fefo="${prod.fefoDiscount}">
            <div class="sim-item-info">
              <span class="sim-item-name">${prod.name}</span>
              <span class="sim-item-meta">
                $${prod.price.toLocaleString('es-CO')} COP / ${prod.unit} •
                <span class="sim-item-fefo">
                  Lote FEFO (-${Math.round(prod.fefoDiscount * 100)}%)
                </span>
              </span>
            </div>
            <div class="sim-qty-control">
              <button class="qty-btn dec" data-id="${prod.id}" aria-label="Disminuir">-</button>
              <span class="qty-val" id="qty-${prod.id}">${quantities[prod.id] || 0}</span>
              <button class="qty-btn inc" data-id="${prod.id}" aria-label="Aumentar">+</button>
            </div>
          </div>
        `).join('');

        bindQtyButtons();
        calculateSim();
      }

      document.querySelectorAll('.type-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.type-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const t = btn.dataset.type || 'burger';
          renderSimulatorItems(t);
        });
      });

      renderSimulatorItems('burger');

      if (btnPlaceDemoOrder) {
        btnPlaceDemoOrder.addEventListener('click', () => {
          const randHash = Array.from({ length: 48 }, () => Math.floor(Math.random() * 16).toString(16)).join('');
          if (rcCufe) rcCufe.textContent = `${randHash.slice(0, 16)}...${randHash.slice(-12)}`;

          btnPlaceDemoOrder.style.background = '#10b981';
          btnPlaceDemoOrder.textContent = 'Orden #PO-' + Math.floor(1000 + Math.random() * 9000) + ' Transmitida con CUFE';

          setTimeout(() => {
            btnPlaceDemoOrder.style.background = '';
            btnPlaceDemoOrder.textContent = 'Emitir Pedido y Factura Demo';
          }, 3500);
        });
      }

      // 8. Particle Network Canvas (Sky Blue #38bdf8 with clean soft alpha)
      const canvas = document.getElementById('fx');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        let width, height;
        const mouse = { x: -999, y: -999 };

        const resize = () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        };
        resize();
        window.addEventListener('resize', resize);
        window.addEventListener('mousemove', (e) => {
          mouse.x = e.clientX;
          mouse.y = e.clientY;
        });

        const particles = Array.from({ length: window.innerWidth < 700 ? 30 : 65 }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          radius: Math.random() * 1.3 + 1,
        }));

        function renderParticles() {
          ctx.clearRect(0, 0, width, height);

          particles.forEach((p, idx) => {
            p.x += p.vx;
            p.y += p.vy;

            if (p.x < 0 || p.x > width) p.vx *= -1;
            if (p.y < 0 || p.y > height) p.vy *= -1;

            const distMouse = Math.hypot(p.x - mouse.x, p.y - mouse.y);
            if (distMouse < 140) {
              p.x += (p.x - mouse.x) * 0.006;
              p.y += (p.y - mouse.y) * 0.006;
            }

            ctx.fillStyle = '#38bdf8';
            ctx.globalAlpha = 0.5;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();

            for (let j = idx + 1; j < particles.length; j++) {
              const p2 = particles[j];
              const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
              if (dist < 120) {
                ctx.globalAlpha = (1 - dist / 120) * 0.18;
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 0.7;
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.stroke();
              }
            }
          });

          requestAnimationFrame(renderParticles);
        }
        renderParticles();
      }
    </script>
  </body>
</html>
